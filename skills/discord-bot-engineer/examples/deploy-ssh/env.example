# Copy to /etc/discord-bot-engineer.env on the host (chmod 600). Never commit real values.
DISCORD_BOT_TOKEN=<DISCORD_BOT_TOKEN>
DISCORD_PUBLIC_KEY=<DISCORD_PUBLIC_KEY>
INGEST_SECRET=<INGEST_SECRET>
ROUTES={"github":"<CHANNEL_ID>","ci":"<CHANNEL_ID>","deploys":"<CHANNEL_ID>"}
AI_ALLOWED_CHANNELS=["<CHANNEL_ID>"]
BOT_USER_ID=<BOT_USER_ID>
GATEWAY_HEALTH_URL=https://<GATEWAY_HOST>/health
PORT=8787
KV_FILE=/var/lib/discord-bot-engineer/seen.json
